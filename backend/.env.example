# Required
KEENABLE_API_KEY=keen_xxx
# Pipeline tuning
SEARCH_MAX_RESULTS=3
SNIPPET_MAX_LENGTH=200
MAX_CLAIMS=12
MAX_NOTE_WORDS=50
# Comma-separated extra CORS origins (chrome-extension:// origins are always allowed)
ALLOWED_ORIGINS=https://www.youtube.com
# Optional: forward /api/v1/report payloads to a webhook (e.g. GitHub issue bot, Slack)
# REPORT_WEBHOOK_URL=
