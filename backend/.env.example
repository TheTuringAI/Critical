# Required
KEENABLE_API_KEY=keen_xxx
# Pipeline tuning
SEARCH_MAX_RESULTS=10
SNIPPET_MAX_LENGTH=200
MAX_CLAIMS=30
MAX_NOTE_WORDS=50
# Comma-separated extra CORS origins (chrome-extension:// origins are always allowed)
ALLOWED_ORIGINS=https://www.youtube.com
# Optional: forward /api/v1/report payloads to a webhook (e.g. GitHub issue bot, Slack)
# REPORT_WEBHOOK_URL=
# Notes scoring below this are dropped (0-7: firm verdict, same subject, figures, institutional source).
# 3 keeps weaker but on-topic notes; 4 keeps only firm, figure-backed ones
MIN_NOTE_USEFULNESS=3
