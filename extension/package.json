{
  "name": "video-context-overlay-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && cross-env VCO_ENTRY=page-bridge vite build --config vite.content.config.ts && cross-env VCO_ENTRY=content vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.6",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "5.6",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
